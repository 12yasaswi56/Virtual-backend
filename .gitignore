# Node modules (these are reinstalled with package.json)
node_modules/

# Yarn/NPM lock files
package-lock.json

# Yarn cache (optional)
.yarn/cache/

# Environment variables (contains secrets)
.env
.env.*

# Logs
logs/
*.log
npm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# Build / temp files
dist/
build/
.cache/
.tmp/

# VSCode settings (optional)
.vscode/
